{
  "name": "alagoas-edu-backend",
  "version": "1.0.0",
  "description": "Backend API for Alagoas Educational Data Processing",
  "main": "dist/server.js",
  "scripts": {
    "prisma:prep": "node scripts/prepare-prisma.js",
    "prisma:generate": "npm run prisma:prep && prisma generate",
    "prisma:push": "npm run prisma:prep && prisma db push",
    "dev": "npm run prisma:prep && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.5",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
